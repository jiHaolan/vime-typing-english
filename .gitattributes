# License/notice bytes are copied and hashed verbatim, including original EOLs.
app/src/main/assets/licenses/*.txt -text -whitespace
app/src/main/assets/rime/** -text -whitespace
app/src/main/assets/input/** -text -whitespace
app/src/main/assets/privacy-notice.json -text

# Source-lock hashes and source-kit tools must survive Windows checkouts.
notices/dictionary-sources.lock.json text eol=lf
tools/analyze_clean_dictionary.py text eol=lf
tools/build_dictionary_exporter.py text eol=lf
tools/build_input_lexicon.py text eol=lf
tools/compile_clean_dictionary.py text eol=lf
tools/export_rime_vocabulary.py text eol=lf
tools/package_dictionary_sources.py text eol=lf
tools/prepare_clean_dictionary.py text eol=lf
tools/prepare_levels.py text eol=lf
tools/run_dictionary_checks.py text eol=lf
tools/test_clean_dictionary.py text eol=lf
tools/verify_dictionary_source_kit.py text eol=lf
tools/verify_input_lexicon.py text eol=lf
tools/verify_rime_upgrade.py text eol=lf
tools/dictionary-compiler/** text eol=lf

app/src/main/assets/english/** -text -whitespace
tools/build_english_lexicon.py text eol=lf
tools/verify_english_lexicon.py text eol=lf
tools/project_rime_runtime.py text eol=lf
tools/optimize_apk_payload.py text eol=lf
tools/test_apk_payload.py text eol=lf

# Native source receipts and packaged metadata use exact-byte hashes.
native/sources.lock.json -text -whitespace
notices/native-notice-sources.json -text -whitespace
app/src/main/assets/native-sources.json -text -whitespace
tools/build_native_engine.py text eol=lf
tools/prepare_native_notices.py text eol=lf
tools/package_native_sources.py text eol=lf
tools/verify_native_source_kit.py text eol=lf
tools/verify_native_userdb.py text eol=lf
tools/native-leveldb-reader/** text eol=lf
