<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/vimePanelBg" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/page_gutter" android:paddingEnd="@dimen/page_gutter" android:paddingTop="24dp" android:paddingBottom="32dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_spark" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="边打字边背单词" android:textSize="15sp" android:textStyle="bold" android:textColor="?attr/vimeInk" />
    </LinearLayout>
    <TextView style="@style/PageTitle" android:layout_marginTop="24dp" android:text="每次输入，
都有一点收获。" />
    <TextView style="@style/BodyText" android:layout_marginTop="10dp" android:text="日常打字认识新词，留一点时间认真记住。" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我的学习" android:textColor="?attr/vimeAccInk" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvLearningCount" style="@style/PageTitle" android:layout_marginTop="8dp" android:text="还没有收藏的词" android:textSize="24sp" />
        <TextView android:id="@+id/tvLearningHint" style="@style/BodyText" android:layout_marginTop="6dp" android:text="在键盘长按候选词，收进你的生词本。" />
        <TextView android:id="@+id/btnStudy" style="@style/Action" android:layout_marginTop="20dp" android:text="打开生词本" />
    </LinearLayout>
    <TextView style="@style/SectionTitle" android:layout_marginTop="28dp" android:text="在打字中认识英文" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none" android:background="@drawable/card_bg" android:padding="8dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <include android:id="@+id/demo1" layout="@layout/candidate_item" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <include android:id="@+id/demo2" layout="@layout/candidate_item" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <include android:id="@+id/demo3" layout="@layout/candidate_item" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView style="@style/BodyText" android:layout_marginTop="10dp" android:text="中文是主角，英文轻轻提醒。长按真实候选词可收藏。" />
    <TextView style="@style/SectionTitle" android:layout_marginTop="28dp" android:text="键盘偏好" />
    <TextView style="@style/BodyText" android:layout_marginTop="8dp" android:text="英文提示范围 · 不影响中文输入" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/lvCet4" style="@style/LevelChip" android:text="CET4" />
        <TextView android:id="@+id/lvCet6" style="@style/LevelChip" android:layout_marginStart="8dp" android:text="CET6" />
        <TextView android:id="@+id/lvToefl" style="@style/LevelChip" android:layout_marginStart="8dp" android:text="TOEFL" />
        <TextView android:id="@+id/lvAll" style="@style/LevelChip" android:layout_marginStart="8dp" android:text="全部" />
    </LinearLayout>
    <TextView android:id="@+id/btnTheme" style="@style/Action" android:layout_marginTop="12dp" android:background="@drawable/pill_bg" android:textColor="?attr/vimeInk" android:gravity="start|center_vertical" android:text="外观主题 · 跟随系统" />
    <TextView android:id="@+id/btnHaptics" style="@style/Action" android:layout_marginTop="8dp" android:background="@drawable/pill_bg" android:textColor="?attr/vimeInk" android:gravity="start|center_vertical" android:text="按键触感 · 已开启" />
    <TextView android:id="@+id/btnVoiceConfig" style="@style/Action" android:layout_marginTop="8dp" android:background="@drawable/pill_bg" android:textColor="?attr/vimeInk" android:gravity="start|center_vertical" android:text="语音输入 · 默认免密钥" />
    <TextView android:id="@+id/btnInputSettings" style="@style/Action" android:layout_marginTop="8dp" android:background="@drawable/pill_bg" android:textColor="?attr/vimeInk" android:gravity="start|center_vertical" android:text="输入与个性化 · 短语、配色、触感" />
    <TextView style="@style/SectionTitle" android:layout_marginTop="28dp" android:text="离线词典" />
    <TextView style="@style/BodyText" android:layout_marginTop="8dp" android:text="导入词包，为中文候选补充英文释义。" />
    <TextView android:id="@+id/btnDictionary" style="@style/Action" android:layout_marginTop="12dp" android:background="@drawable/soft_action_bg" android:textColor="?attr/vimeAccInk" android:text="管理词包与查词" />
    <TextView android:id="@+id/tvStat" style="@style/BodyText" android:layout_marginTop="10dp" android:text="正在载入本机词典…" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="20dp">
        <TextView style="@style/SectionTitle" android:text="键盘连接状态" />
        <TextView android:id="@+id/tvStep1" style="@style/BodyText" android:layout_marginTop="12dp" android:text="尚未在系统中启用" />
        <TextView android:id="@+id/btnEnable" style="@style/Action" android:layout_marginTop="12dp" android:background="@drawable/pill_bg" android:textColor="?attr/vimeInk" android:text="前往系统设置" />
        <TextView android:id="@+id/tvStep2" style="@style/BodyText" android:layout_marginTop="12dp" android:text="用手机系统键盘菜单选择本输入法" />
    </LinearLayout>
    <TextView style="@style/BodyText" android:layout_marginTop="24dp" android:gravity="center" android:text="拼音离线使用 · 手机语音默认免密钥
只收藏你主动选择的词" android:textSize="12sp" />
</LinearLayout>
</ScrollView>

