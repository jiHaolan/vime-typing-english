<?xml version="1.0" encoding="utf-8"?>
<!--
  九宫格键盘（拼音九键）。3 列 × 4 行，与字母键盘同为 4 行、等高。
  按下后 buffer 累积的是数字，由 DictRepository.t9Candidates() 反查拼音。
  第 4 行复用中英/空格/删除，和字母键盘的语义保持连续。
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="26%p"
    android:keyHeight="@dimen/key_height"
    android:horizontalGap="0px"
    android:verticalGap="6dp">

    <Row>
        <Key android:codes="44" android:keyLabel="，" />
        <Key android:codes="50" android:keyLabel="ABC" />
        <Key android:codes="51" android:keyLabel="DEF" />
        <Key android:codes="-5" android:keyLabel="⌫" android:keyWidth="22%p" />
    </Row>

    <Row>
        <Key android:codes="52" android:keyLabel="GHI" />
        <Key android:codes="53" android:keyLabel="JKL" />
        <Key android:codes="54" android:keyLabel="MNO" />
        <Key android:codes="32" android:keyLabel="空格" android:keyWidth="22%p" />
    </Row>

    <Row>
        <Key android:codes="55" android:keyLabel="PQRS" />
        <Key android:codes="56" android:keyLabel="TUV" />
        <Key android:codes="57" android:keyLabel="WXYZ" />
        <Key android:codes="46" android:keyLabel="。" android:keyWidth="22%p" />
    </Row>

    <Row>
        <Key android:codes="-2" android:keyLabel="123" />
        <Key android:codes="-20001" android:keyLabel="英" />
        <Key android:codes="-20002" android:keyLabel="全键" />
        <Key android:codes="-4" android:keyLabel="换行" android:keyWidth="22%p" />
    </Row>
</Keyboard>

