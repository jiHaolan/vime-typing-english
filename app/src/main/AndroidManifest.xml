<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries><intent><action android:name="android.speech.RecognitionService" /></intent><intent><action android:name="android.intent.action.TTS_SERVICE" /></intent></queries>

    <!--
      P0 修复：必须给 application 指定 AppCompat 主题。
      MainActivity 继承 AppCompatActivity，若没有 Theme.AppCompat 后代主题，
      启动时会抛 IllegalStateException 直接闪退（这就是「装了打不开」的原因之一）。
    -->
    <application
        android:name=".VimeApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/ImeTheme">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/ImeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LearningActivity" android:exported="false"
            android:taskAffinity="com.vime.ime.learning" android:excludeFromRecents="true"
            android:theme="@style/ImeTheme" />
        <activity android:name=".LearningDataActivity" android:exported="false" android:theme="@style/ImeTheme" />

        <activity android:name=".VoiceInputActivity" android:exported="false"
            android:taskAffinity="com.vime.ime.voice" android:excludeFromRecents="true"
            android:theme="@style/VoicePermissionTheme" />

        <activity android:name=".VoiceSettingsActivity" android:exported="false" android:theme="@style/ImeTheme" />
        <activity android:name=".InputSettingsActivity" android:exported="false" android:theme="@style/ImeTheme" />

        <activity android:name=".DictionaryActivity" android:exported="false"
            android:taskAffinity="com.vime.ime.dictionary" android:excludeFromRecents="true"
            android:theme="@style/ImeTheme" />

        <service
            android:name=".VimeImeService"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:theme="@style/ImeKeyboardTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>
</manifest>
